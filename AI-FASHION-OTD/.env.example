# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ai_fashion_companion

# JWT Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=your-minimum-32-character-long-access-token-secret-key-here
JWT_REFRESH_SECRET=your-minimum-32-character-long-refresh-token-secret-key-here
JWT_SECRET=your-legacy-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# AI Service Integration (Optional)
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_MS=15000

# Weather API (Optional - OpenWeatherMap)
OPENWEATHER_API_KEY=

